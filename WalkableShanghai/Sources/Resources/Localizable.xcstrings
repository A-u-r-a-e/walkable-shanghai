    "saved.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline routes keep their own data, their walker notes and a drawing of the route line on this phone, so they open with no signal. Street names and surroundings need a connection. Nothing is synced between devices yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线路线会在本机保留路线数据、记录者留言，以及一张路线示意图，无网络时也能打开。街道名称与周边信息仍需联网。目前尚不支持设备间同步。"
          }
        }
      }
