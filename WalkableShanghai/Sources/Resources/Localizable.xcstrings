    "onboarding.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A street thick with plane trees is not the same as a street you can walk for an hour. Every route here was walked end to end before it was published."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绿树成荫的街道，不等于能走上一小时的街道。这里的每条路线都由人亲自走完后才发布。"
          }
        }
      }
    },
