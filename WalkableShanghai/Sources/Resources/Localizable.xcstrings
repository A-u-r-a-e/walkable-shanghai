{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.eyebrow": {
      "comment": "Small gold label above the onboarding headline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkable Shanghai"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可步行的上海"
          }
        }
      }
    },
    "onboarding.headline": {
      "comment": "The app's opening statement — the problem it exists to fix.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walks end too soon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "散步总是被迫结束。"
          }
        }
      }
    },
    "onboarding.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A street thick with plane trees is not the same as a street you can walk for an hour. Every route here was walked end to end before it was published, and it tells you where it breaks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绿树成荫的街道，不等于能走上一小时的街道。这里的每条路线都由人亲自走完后才发布，并会告诉你它在哪里断开。"
          }
        }
      }
    },
    "onboarding.length.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Length"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长度"
          }
        }
      }
    },
    "onboarding.length.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far it actually goes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际能走多远"
          }
        }
      }
    },
    "onboarding.ends.title": {
      "extractionState": "manual",
      "localizations": {
